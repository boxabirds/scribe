// Scribe surface grammar, version 0.4, for specification draft 0.5.
// Version 0.2 was the pilot's (experiment 3); research/grammar keeps it.
//
// Generated by tools/build_grammar.py from this template. The generator adds:
//   - `name`: an identifier, or any SOFT keyword (a word that is a keyword only
//     in its own position; see HARD in build_grammar.py),
//   - QUANTITY: a number followed directly by a word that is not a keyword.
//
// SPEC n in a comment names the section of the specification a rule serves.
//
// The code reads like code: calls `f(a, b)`, fields `a.b`, `let x = 1`, `==`.
// English is kept where it carries meaning: contracts and condition groups.
// No rule uses the symbol table: the parser never knows which names are types,
// variants, functions or fields.

start: item*

?item: function | typedecl | enum | module | interface
     | stmt

block: _NL _INDENT stmt+ _DEDENT

// ---------------------------------------------------------------- functions
// SPEC 4.1: parameters and their types in the header, as in Rust and Swift
function: "function" name "(" [param ("," param)*] ")" ["->" typeexpr] _NL [_INDENT clause* stmt* _DEDENT]
param: name ":" typeexpr

// SPEC 10.1: the contract, between the header and the body
?clause: fails | expect | ensure | changes | uses_clause | example | property
fails: "can" "fail" "with" name_list _NL
expect: "expect" line_condition
ensure: "ensure" ensure_body _NL
      | "ensure" group                                         -> ensure_group
      | "ensure" if_then                                       -> ensure_if_then
ensure_body: expr
           | "on" "success" "," expr                           -> on_success
           | "on" "failure" [name ("or" name)*] "," expr       -> on_failure_case
           | "if" logic "," expr                               -> conditional
changes: "changes" "only" postfix ("," postfix)* _NL
uses_clause: "uses" name_list _NL
example: "example" expr _NL
property: "property" quantified _NL

name_list: name ("," name)*

// ---------------------------------------------------------------- types
// SPEC 3: a convention, then a state (SPEC 7.3: `Open Connection`), then the type;
// SPEC 3.4: `or nothing` when the value may be absent
typeexpr: modifier* [type_state] type_name ["or" "nothing"]
modifier: "editable" | "consumed"
type_state: name
type_name: name ["[" typeexpr ("," typeexpr)* "]"]

range: sum range_word sum
range_word: "until" | "through"

// SPEC 3.2, 3.5: a record, or a refinement of another type
typedecl: "type" name ["[" name ("," name)* "]"] ["is" typeexpr ["in" range]] _NL [_INDENT member+ _DEDENT]
?member: name ":" typeexpr _NL                                 -> field
       | "model" name "=" expr _NL                             -> model
       | "invariant" line_condition                            -> type_invariant
       | "states" name ("," name)+ _NL                         -> states
// SPEC 3.3: as in Rust and Swift
enum: "enum" name _NL _INDENT variant+ _DEDENT
variant: name ["(" param ("," param)* ")"] _NL

// SPEC 11.2: every implementation meets the interface's contracts
interface: "interface" name _NL _INDENT function+ _DEDENT

// SPEC 11.1: the static dependency graph impact analysis walks, as in Java modules
module: "module" name _NL _INDENT module_section+ _DEDENT
?module_section: "requires" _NL _INDENT need+ _DEDENT           -> requires
               | "exports" _NL _INDENT function+ _DEDENT         -> exports
need: name "as" name _NL [_INDENT "uses" name_list _NL _DEDENT]

// ---------------------------------------------------------------- statements
?stmt: let | var | assign | return_stmt | fail | do_nothing | if_stmt | for_stmt
     | while_stmt | invariant | decreases | match | handle | hold | together
     | break_stmt | continue_stmt | trust | assert_stmt | elided | expr_stmt

// SPEC 4.2: `=` binds or assigns; equality is `==`
let: "let" name "=" expr ["else" expr] _NL
   | "let" name "=" group                                      -> let_group
var: "var" name "=" expr _NL
assign: postfix "=" expr _NL
return_stmt: "return" [expr] _NL
           | "return" group                                    -> return_group
fail: "fail" "with" expr _NL
do_nothing: "do" "nothing" _NL
// SPEC 5.2: a condition group as the condition is followed by `then` (for `if`) or
// `do` (for `while`) on its own line, so the two blocks are told apart
if_stmt: "if" if_body ("else" "if" if_body)* ["else" block]
if_body: expr block
       | group "then" block
for_stmt: "for" name "in" (range | expr) block
while_stmt: "while" expr block
          | "while" group "do" block
invariant: "invariant" line_condition
decreases: "decreases" expr _NL
match: "match" expr _NL _INDENT case+ _DEDENT
case: "case" pattern block
pattern: name ["(" name ("," name)* ")"]
handle: "handle" block on_failure+
on_failure: "on" "failure" name ("or" name)* ["as" name] block
hold: "hold" name "=" expr block
together: "together" block
break_stmt: "break" _NL
continue_stmt: "continue" _NL
// SPEC 10.5: the checker does not verify a `trust` block, and takes an `assert`
// inside one as true
trust: "trust" block
assert_stmt: "assert" line_condition
elided: ELIDED _NL
// SPEC 4.2: a statement is a keyword line, an assignment or a call
expr_stmt: postfix _NL
         | "try" postfix _NL                                   -> try_

// ---------------------------------------------------------------- conditions
// SPEC 1: every line has exactly one reading without any precedence rule beyond
// school arithmetic. `and` and `or` never mix on one line; `not` negates a whole
// condition; a quantifier covers the rest of its line.
?expr: condition
?condition: quantified
          | not_op comparison                                  -> not_
          | logic
?logic: comparison (and_op comparison)+                        -> and_chain
      | comparison (or_op comparison)+                         -> or_chain
      | comparison
and_op: "and" | "∧" | "&&"
or_op: "or" | "∨" | "||"
not_op: "not" | "¬" | "!"
for_all: "for" "all" | "∀"
quantified: for_all name ("in" (range | sum) | ":" typeexpr) "," condition
          | ("there" "is" | "∃") name "in" sum "where" condition -> exists

// SPEC 5.2: a condition group joins conditions by its header, one per line in an
// indented block, or several on one line separated by commas. Groups nest. A
// comma at the end of a line in a block is optional and, if present, must be
// followed by another item of the same block.
group: group_kind "of" (_NL _INDENT group_item* group_last _DEDENT | inline_group _NL)
group_kind: "all" | "any" | "not" "any"
// on one line, an item cannot hold a quantifier: it would swallow the items after it
inline_group: inline_item ("," inline_item)+
?inline_item: not_op comparison                                -> not_
            | comparison
?group_item: item_condition (LINE_COMMA | _NL)
           | group
?group_last: item_condition _NL
           | group
// one condition per item: the group's header is the only thing joining its items
?item_condition: quantified
               | not_op comparison                             -> not_
               | comparison
// SPEC 5.2: one condition implies another, written as two aligned lines
if_then: _NL _INDENT "if" condition _NL "then" condition _NL _DEDENT
// what may follow a clause word: a condition on the line, a group, or an if/then
?line_condition: condition _NL
               | group
               | if_then

?comparison: sum
           | sum (comp_op sum)+                                -> compare
comp_op: "==" | "!=" | "≠"
       | "<" | ">" | "<=" | "≤" | ">=" | "≥"
       | "is" | "is" "not"
       | "in" | "∈" | "not" "in"

// ---------------------------------------------------------------- expressions
?sum: product (("+" | "-") product)*
?product: unary (("*" | "/" | "%") unary)*
// SPEC 5.2: `-` and `try` apply to the next term, as minus does at school
?unary: "-" unary                                              -> neg
      | "try" unary                                            -> try_
      | postfix
// SPEC 5.1: calls `f(a, b)`, named arguments `f(a, to: b)`, fields `a.b`, items `a[i]`
?postfix: atom
        | postfix "." name                                     -> field_access
        | postfix "(" [arg ("," arg)*] ")"                     -> call
        | postfix "[" sum "]"                                  -> index
?arg: expr
    | name ":" expr                                            -> named_arg
// SPEC 5.2: brackets group arithmetic only; logic is grouped by layout
?atom: literal
     | name
     | "(" sum ")"
     | "[" [comparison ("," comparison)*] "]"                  -> list
     | "[" comparison "for" name "in" sum ["where" condition] "]" -> comprehension
     | "result"                                                -> result
     | "nothing"                                               -> nothing
     | "old" "(" expr ")"                                      -> old
?literal: INT | DECIMAL | STRING | QUANTITY | HEX | BINARY


// ---------------------------------------------------------------- terminals
_NL: "⏎"
// a comma that ends a line is read with the line's end, so it is never taken for
// a comma inside the line (the optional comma in a condition group)
LINE_COMMA.9: /,[ ]*⏎/
_INDENT: "⇥"
_DEDENT: "⇤"
ELIDED: "⋯"
STRING: /"([^"\\]|\\.)*"/
// hex and binary literals, with `_` allowed between digits
HEX.3: /0x[0-9A-Fa-f](_?[0-9A-Fa-f])*/
BINARY.3: /0b[01](_?[01])*/
DECIMAL.1: /\d+\.\d+/
INT: /\d+/
NAME: /[A-Za-z][A-Za-z0-9_]*/
%ignore /[ \t\n]+/

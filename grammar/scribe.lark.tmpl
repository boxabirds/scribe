// Scribe surface grammar, version 0.3, for specification draft 0.4.
// Version 0.2 was the pilot's (experiment 3); research/grammar keeps it.
//
// Generated by tools/build_grammar.py from this template. The generator adds:
//   - `name`: an identifier, or any SOFT keyword (a phrase word that is only a
//     keyword inside its own phrase; see HARD and SOFT in build_grammar.py),
//   - QUANTITY: a number followed directly by a word that is not a keyword.
//
// Conventions in comments:
//   DOC     rule taken from a rule or table in the doc
//   EX n    construct needed by worked example n, consistent with the doc
//   SPECIAL a phrase used by one example only (counted in the results)
//   FIX-n   a disambiguation decision proposed by this experiment (see results)
//   SPEC n  added in version 0.3 for section n of the specification
//
// No rule uses the symbol table. The parser never knows which names are types,
// variants, units, operations or predicates.

start: (item)*

?item: operation | typedecl | enum | component | example | property
     | interface
     | stmt

block: _NL _INDENT stmt+ _DEDENT

// ---------------------------------------------------------------- operations
operation: "to" signature _NL [_INDENT clause* stmt* _DEDENT]              // DOC
signature: name [name ("," name)*] ((label | "of") name)*              // DOC; FIX-3; SPEC 4.1 several unlabelled parameters

?clause: given | produces | fails | expect | ensure | changes | uses_clause
       | example | property

given: "given" name "is" typeexpr _NL
produces: "produces" typeexpr _NL
fails: "can" "fail" "with" name_list _NL                                  // SPEC 10.1: not `fails`, which looked like `fail`
expect: "expect" line_condition
ensure: "ensure" ensure_body _NL
       | "ensure" group                                                    -> ensure_group
       | "ensure" if_then                                                 -> ensure_if_then
ensure_body: expr
           | "on" "success" "," expr                                        -> on_success
           | "on" "failure" [name ("or" name)*] "," expr                    -> on_failure_case
           | "if" logic "," expr                                             -> conditional   // SPEC 15
changes: "changes" "only" place ("," place)* _NL                          // SPEC 13.2: several places
uses_clause: "uses" name_list _NL

name_list: name ("," name)*

// ---------------------------------------------------------------- types
// SPEC 7.3: a state reads as an adjective before its type: `an Open Connection`
typeexpr: [article] modifier* [type_state] type_name type_suffix*
type_state: name
article: "a" | "an" | "the"
modifier: "editable" | "consumed" | "maybe"
type_name: name ["of" modifier* type_name]
?type_suffix: "with" name term range_word term        -> refine_range
            | "as" name                               -> role
range: expr range_word expr
range_word: "until" | "through"

// ---------------------------------------------------------------- declarations
typedecl: "type" name ["of" name] ["is" typeexpr] _NL [_INDENT member+ _DEDENT]
?member: name "as" typeexpr _NL                       -> field
       | "model" name "as" expr _NL                   -> model
       | "invariant" line_condition                   -> type_invariant
       | "states" name ("," name)+ _NL                -> states       // SPEC 7.3: typestate
enum: "enum" name _NL _INDENT variant+ _DEDENT                            // SPEC 3.3: as in Rust and Swift
variant: name ["with" field_decl ("," field_decl)*] _NL                       // SPEC 3.3: parts take commas
field_decl: name "as" typeexpr

example: "example" expr _NL
// SPEC 11.2: an interface states contracts every implementation must meet
// SPEC 10.3: a fact that varies by host is an operation of the capability's interface
interface: "interface" name _NL _INDENT operation+ _DEDENT
property: "property" quantified _NL

// ---------------------------------------------------------------- components and systems
// SPEC 11.1: versions are kept in the package file, outside the language
component: "component" name _NL _INDENT comp_section+ _DEDENT
?comp_section: "needs" _NL _INDENT need+ _DEDENT                  -> needs
             | "provides" _NL _INDENT operation+ _DEDENT          -> provides
need: name "as" name _NL [_INDENT "uses" name_list _NL _DEDENT]


// ---------------------------------------------------------------- statements
?stmt: let | var | set | update | return_stmt | fail | do_nothing | if_stmt | for_each
     | repeat_while | invariant | decreases | choose | handle | hold
     | together | stop | skip | trust | assert_stmt | elided
     | expr_stmt

// SPEC 5.1: a call with several unlabelled arguments stands bare only as a whole
// statement or a whole value; anywhere else it takes parentheses, because a
// comma also separates list items, parts and quantifier ranges
?value: expr
      | comma_call
      | "try" comma_call                                          -> try_
comma_call: name operand ("," operand)+ label_arg*
let: "let" name "be" value [COMMA_OTHERWISE expr] _NL
   | "let" name "be" group                                          -> let_group
var: "var" name "starts" "at" value _NL
set: "set" place "to" value _NL
// SPEC 2.1: the update forms; each word is reserved, so none can name an operation
?update: "increment" place _NL                                  -> increment
       | "decrement" place _NL                                  -> decrement
       | "add" term "to" place _NL                              -> add_to
       | "subtract" term "from" place _NL                       -> subtract_from
// FIX-7, SPEC 4.2: a settable place is a name, an element (`item i of heap`) or
// an of-path; or a possessive path (SPEC 5.1), never mixed with `of`
place: path_place | possessive_place
path_place: name operand* ["of" path_place]
possessive_place: name ("'s" name)+
return_stmt: "return" value _NL
           | "return" group                                       -> return_group
// SPEC 6: a failure is a value, so `fail with` takes any expression
fail: "fail" "with" value _NL
// SPEC 4.2: a statement that does nothing, for a branch with nothing to do
do_nothing: "do" "nothing" _NL
// SPEC 5.2: a condition group as the condition is followed by `then` (for `if`) or
// `do` (for `repeat while`) on its own line, so the two blocks are told apart
if_stmt: "if" if_body ("otherwise" "if" if_body)* ["otherwise" block]
if_body: expr block
       | group "then" block
for_each: FOR_EACH name "from" expr range_word expr block
        | FOR_EACH name "in" expr block                            -> for_each_in
repeat_while: "repeat" "while" expr block
            | "repeat" "while" group "do" block
invariant: "invariant" line_condition
decreases: "decreases" expr _NL
choose: "choose" expr _NL _INDENT when+ _DEDENT
when: "when" pattern block
pattern: "some" name                              -> some_pattern
       | "nothing"                                -> nothing_pattern
       | name ["with" name ("," name)*]         -> variant_pattern
handle: "handle" block on_failure+
on_failure: "on" "failure" name ("or" name)* ["as" name] block
hold: "hold" name "as" expr block
together: "together" block
stop: "stop" _NL
skip: "skip" _NL
// SPEC 10.5: the checker does not verify a `trust` block, and takes an `assert`
// inside one as true
trust: "trust" block
assert_stmt: "assert" line_condition
elided: ELIDED _NL
// SPEC 4.2: every statement starts with a keyword or is a call, so a bare
// expression (`x + 1`, `count = count + 1`) is not a statement
expr_stmt: (call | name | comma_call | "try" application | "try" comma_call) _NL

// ---------------------------------------------------------------- expressions
// SPEC 1: every line has exactly one reading without any precedence rule beyond
// school arithmetic, so this grammar needs no disambiguation rules.
//
// A condition stands alone: on its own line, after a clause word, or as one item
// of a condition group. A word that opens a scope (a quantifier, `there is`,
// `where`, a comprehension's `for each`) covers the rest of its line (SPEC 3), so
// a quantifier is never an operand. `and` and `or` never mix on one line, and
// `not` negates a whole condition, never one link of a chain (SPEC 7). The
// symbols are accepted on input and never displayed (SPEC 2.3).
?expr: condition
?condition: quantified
          | aggregate
          | where_call
          | "try" where_call                                  -> try_
          | construction
          | tail_comparison
          | not_op comparison                                 -> not_
          | logic
?logic: comparison (and_op comparison)+                         -> and_chain
      | comparison (or_op comparison)+                          -> or_chain
      | comparison
and_op: "and" | "∧" | "&&"
or_op: "or" | "∨" | "||"
not_op: "not" | "¬" | "!"
for_every: "for" "all" | "∀"                                              // not `for every`, which looked like `for each`
quantified: for_every name ["in" sum | "from" sum range_word sum | "as" typeexpr] "," condition
          | ("there" "is" | "∃") [article] name "in" sum "where" condition -> exists

// SPEC 2.6: a condition group joins conditions by its header, one per line in an
// indented block, or several on one line separated by commas. Groups nest. A
// comma at the end of a line in a block is optional and, if present, must be
// followed by another item of the same block (SPEC 11).
group: group_kind "of" (_NL _INDENT group_item* group_last _DEDENT | inline_group _NL)
group_kind: "all" | "any" | "not" "any"                                    // not `none`, which looked like `nothing`
// on one line, an item cannot hold a word that covers the rest of the line
// (a quantifier, `where`, a comprehension): it would swallow the items after it
inline_group: inline_item ("," inline_item)+
?inline_item: not_op comparison                                -> not_
            | comparison
?group_item: item_condition (LINE_COMMA | _NL)
           | group
?group_last: item_condition _NL
           | group
// one condition per item: the group's header is the only thing joining its items,
// so an item holds no `and` or `or` chain (SPEC 2)
?item_condition: quantified
               | aggregate
               | where_call
               | tail_comparison
               | "try" where_call                             -> try_
               | not_op comparison                            -> not_
               | comparison
// SPEC 2: one condition implies another, written as two aligned lines
if_then: _NL _INDENT "if" condition _NL "then" condition _NL _DEDENT
// what may follow a clause word or `be`: a condition on the line, a group, or
// an if/then block
?line_condition: condition _NL
               | group
               | if_then

?comparison: concat
           | concat (comp_op concat)+                           -> compare
// a comprehension or a `where` covers the rest of its line, so it may be the
// last operand of a comparison that is a whole condition
tail_comparison: concat (comp_op concat)* comp_op (aggregate | where_call) -> compare
// FIX-5: bare "in" is no longer a membership alias; "is in" and "∈" remain.
comp_op: "is" | "=" | "=="
       | "is" "not" | "!=" | "≠"
       | "<"
       | ">"
       | "<=" | "≤"
       | ">=" | "≥"
       | "is" "in" | "∈"
       | "is" "not" "in"

// SPEC 14: arithmetic in an operand takes brackets
?concat: sum
?sum: product (("+" | "-") product)*
?product: unary (("*" | "/" | "mod") unary)*
// SPEC 7: `-`, `some` and `try` apply to the next term, as minus does at school
?unary: "-" unary -> neg
      | "some" unary -> some
      | postfix
?postfix: application
        | application AT_ENTRY                                -> at_entry

// FIX-3: "of" is an argument label, used at most once and first; its operand
// may itself be an of-path or a call with positional operands. Every other
// label belongs to the outermost call on the line.
// FIX-4: a comprehension may only be the final "of" operand, or in parentheses.
// SPEC 15: a record built with named fields runs to the end of its line, like a
// comprehension, so a construction is a whole value or sits in brackets
?application: call | operand
          | "try" application                                   -> try_
call: name operand+
    | name operand* "of" of_operand label_arg*
    | name operand* label_arg+
aggregate: name operand* "of" comprehension
// a labelled argument may be a possessive path; an `of` operand may not (SPEC 5.1)
label_arg: label (of_operand | possessive)
// SPEC 3: `where` covers the rest of its line, so a call with a `where` is the
// whole condition or value, or sits in brackets
where_call: name operand* ["of" of_operand] label_arg* "where" condition
of_operand: name operand* ["of" of_operand]
          | atom
comprehension: of_operand FOR_EACH name "in" of_operand ["where" condition]
label: "from" | "for" | "with" | "in" | "into"
     | "to" | "by" | "as"
// FIX-6: a construction lists its parts with commas, not "and".
// SPEC 5.3: parts by position, then fields by name; or fields by name alone. A
// part is written like a call argument, so a labelled call or an operator in a
// part takes parentheses, as it does in an argument
construction: article name "from" of_operand ("," of_operand)* ["with" field_init ("," field_init)*]
            | article name "with" field_init ("," field_init)*
field_init: name "as" comparison

?operand: name | atom | possessive
// SPEC 15: where a phrase word follows a value (`add … to`, `subtract … from`,
// limits in a type), the value is one term: a name, an `of`-path, a literal, a
// possessive or brackets, so a label word after it always belongs to the phrase
?term: of_operand | possessive
     | "-" term                                                 -> neg
// SPEC 5.1: `account's balance` is `balance of account`; a possessive path never
// mixes with `of`, so `name of user's manager` is rejected
possessive: (name | atom) ("'s" name)+
// SPEC 4: brackets group arithmetic only; logic is grouped by layout
?atom: literal
     | "(" concat ")"
     | "(" comma_call ")"
     | "(" aggregate ")"
     | "(" construction ")"
     | "(" where_call ")"
// a comprehension standing alone makes a list, so it is written in list brackets
     | "[" comprehension "]"                                    -> comprehension_value   // FIX-4, SPEC 4
     | "[" [comparison ("," comparison)*] "]"                   -> list
     | "result"                                                 -> result
     | "nothing"                                                -> nothing
?literal: INT | DECIMAL | STRING | QUANTITY | HEX | BINARY


// ---------------------------------------------------------------- terminals
_NL: "⏎"
// a comma that ends a line is read with the line's end, so it is never taken for
// a comma inside the line (SPEC 11: the optional comma in a condition group)
LINE_COMMA.9: /,[ ]*⏎/
_INDENT: "⇥"
_DEDENT: "⇤"
ELIDED: "⋯"
STRING: /"([^"\\]|\\.)*"/
// SPEC 13: hex and binary literals, with `_` allowed between digits
HEX.3: /0x[0-9A-Fa-f](_?[0-9A-Fa-f])*/
BINARY.3: /0b[01](_?[01])*/
DECIMAL.1: /\d+\.\d+/
INT: /\d+/
NAME: /[A-Za-z][A-Za-z0-9_]*/
%ignore /[ \t\n]+/

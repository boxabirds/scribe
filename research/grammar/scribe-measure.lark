// MEASUREMENT VARIANT of the v0.2 grammar: an elided line may stand in for any
// line-level construct, so tools/measure_lines.py can keep parsing after an error.
// Scribe surface grammar, pilot version 0.2 (experiment 3)
//
// Generated by tools/build_grammar.py from this template. The generator adds:
//   - `name`: an identifier, or any SOFT keyword (a phrase word that is only a
//     keyword inside its own phrase; see HARD and SOFT in build_grammar.py),
//   - QUANTITY: a number followed directly by a word that is not a keyword.
//
// Conventions in comments:
//   DOC     rule taken from a rule or table in the doc
//   EX n    construct needed by worked example n, consistent with the doc
//   SPECIAL a phrase used by one example only (counted in the results)
//   FIX-n   a disambiguation decision proposed by this experiment (see results)
//
// No rule uses the symbol table. The parser never knows which names are types,
// variants, units, operations or predicates.

start: (item)*

?item: operation | workflow | define | typedecl | choice | protocol
     | schema | migration | component | system | example | property
     | stmt

block: _NL _INDENT stmt+ _DEDENT

// FIX-9: a clause whose expression is a single quoted string is informal (prose).

// ---------------------------------------------------------------- operations
operation: "to" signature _NL [_INDENT clause* stmt* proof? _DEDENT]        // DOC
workflow: "workflow" signature _NL _INDENT clause* stmt* _DEDENT           // EX 40
signature: name [name] ((label | "of") name)*                          // DOC; FIX-3 "of" is a label, so it may be declared

?clause: elided | given | produces | fails | expect | ensure | changes | uses_clause
       | tier | idempotent | declassifies | deadline | runs | survives | holds

given: "given" name "is" typeexpr _NL
produces: "produces" typeexpr _NL
fails: "fails" "with" name_list _NL
expect: "expect" expr [because] _NL
ensure: "ensure" ensure_body [because] _NL
ensure_body: expr
           | "if" "it" "succeeds" "," expr                                  -> on_success
           | "if" "it" "fails" ["with" "anything" "but" name] "," expr       -> on_failure_case
           | "if" expr "," expr                                              -> conditional
changes: "changes" "only" expr _NL
uses_clause: "uses" name_list _NL
tier: "tier" name ["for" name ("," name "for" "everything" "else")?] _NL
idempotent: "idempotent" "by" name_list _NL
declassifies: "declassifies" name "to" name because _NL
deadline: "deadline" QUANTITY _NL
runs: "runs" "at" "most" "once" "per" name _NL                                // SPECIAL EX 40
survives: "survives" "restarts" _NL                                          // SPECIAL EX 40
holds: "holds" "when" expr _NL
because: "because" STRING

name_list: name ("," name)*

// ---------------------------------------------------------------- types
typeexpr: [article] modifier* type_name type_suffix*
article: "a" | "an" | "the"
modifier: "positive" | "editable" | "consumed" | "maybe" | "non_empty"
type_name: name ["of" modifier* type_name]
?type_suffix: "with" name range                       -> refine_range
            | "limited" "to" cap_spec                 -> limited
            | "labelled" name                         -> labelled
            | "in" "state" name ("or" name)*          -> in_state
            | "as" name                               -> role
            | "matching" name                         -> matching
            | "less" "than" expr                      -> refine_less
            | "at" "most" QUANTITY                    -> refine_at_most
range: expr range_word expr
range_word: "until" | "through"

// capability descriptions, shared by types, attenuation and system grants (EX 19, 20, 22, 32)
cap_spec: [cap_kind] cap_part+
cap_kind: "files" | "network" | "database"
?cap_part: "under" STRING -> under
         | "host" STRING  -> host
         | "port" INT     -> port
         | STRING         -> resource
         | "read" "only"  -> read_only
         | "read" "and" "write" -> read_write

// ---------------------------------------------------------------- declarations
typedecl: "type" name ["of" name] ["in" "state" name ("or" name)*] ["is" typeexpr] _NL [_INDENT member+ _DEDENT]
?member: elided
       | "field" name "as" typeexpr _NL               -> field
       | "model" name "as" expr _NL                   -> model
       | "invariant" expr [because] _NL               -> type_invariant
choice: "choice" name _NL _INDENT variant+ _DEDENT
variant: elided | name ["with" field_decl ("and" field_decl)*] _NL
field_decl: name "as" typeexpr
define: "define" name "is" predicate_phrase _NL _INDENT clause+ _DEDENT
predicate_phrase: name | article name ["of" name]

example: "example" expr _NL
property: "property" quantified _NL

// ---------------------------------------------------------------- protocols
protocol: "protocol" name _NL _INDENT proto_step+ _DEDENT
?proto_step: elided | role_send
           | "repeat" _NL _INDENT proto_step+ _DEDENT "until" role_send -> proto_repeat
role_send: name "sends" message_spec _NL
         | name "sends" "one" "of" message_spec ("," "or" message_spec)+ _NL    -> role_send_choice
message_spec: name ["with" field_decl ("and" field_decl)*]

// ---------------------------------------------------------------- components and systems
component: "component" name "version" version _NL _INDENT comp_section+ _DEDENT
?comp_section: elided
             | "about" PROSE _NL                                  -> about
             | "needs" _NL _INDENT need+ _DEDENT                  -> needs
             | "may" _NL _INDENT may_line+ _DEDENT                -> may
             | "assumes" _NL _INDENT assumption+ _DEDENT          -> assumes
             | "provides" _NL _INDENT operation+ _DEDENT          -> provides
             | "failure" _NL _INDENT failure_line+ _DEDENT        -> failure_section
             | tier
need: elided | name "from" version "as" name _NL [_INDENT "uses" name_list _NL _DEDENT]
?may_line: elided
         | "nothing" "of" "its" "own" _NL                         -> no_authority   // SPECIAL EX 28
         | cap_spec _NL
assumption: elided | expr "assumed" "owner" name "monitor" monitor_policy _NL
monitor_policy: "checking" | "sampling" QUANTITY
?failure_line: elided
             | "domain" name _NL                                                    -> domain
             | "retry" name "at" "most" INT "times" "with" "backoff" QUANTITY because _NL -> retry   // SPECIAL EX 28

system: "system" name "version" version _NL _INDENT sys_section+ _DEDENT
?sys_section: elided
            | "components" _NL _INDENT (name version _NL)+ _DEDENT                  -> components
            | "authority" _NL _INDENT authority_line+ _DEDENT                   -> authority
            | "wiring" _NL _INDENT wiring_line+ _DEDENT                         -> wiring
            | "failure" "domains" _NL _INDENT domain_line+ _DEDENT              -> failure_domains
            | "rules" _NL _INDENT rule_line+ _DEDENT                            -> rules
?authority_line: elided
               | "root" "gives" name cap_spec _NL                               -> grant
               | "nothing" "else" "holds" "authority" _NL                       -> no_other_authority   // SPECIAL
wiring_line: elided | name "needs" name_list ["(" "read" "operations" "only" ")"] _NL   // SPECIAL parenthesised qualifier
?domain_line: elided
            | name "contains" name_list _NL                                     -> domain_members
            | "a" "failure" "in" name "must" "not" "stop" name _NL              -> isolation   // SPECIAL
?rule_line: elided
          | "only" name "can" "reach" cap_spec _NL                              -> reach_rule   // SPECIAL
          | "no" "value" "labelled" name "leaves" name _NL                      -> flow_rule    // SPECIAL
          | name "cannot" "write" "to" cap_spec _NL                             -> write_rule   // SPECIAL

schema: "schema" name "version" INT "compatibility" name _NL _INDENT schema_field+ _DEDENT
?schema_field: elided
             | name "as" typeexpr ["added" "in" "version" INT] _NL
             | name "reserved" "removed" "in" "version" INT _NL                -> reserved_field
migration: "migration" name "from" "version" INT "to" "version" INT "turning" name "into" name _NL _INDENT ensure+ _DEDENT

// ---------------------------------------------------------------- statements
?stmt: let | var | set | give_back | fail | if_stmt | for_each
     | repeat_while | invariant | decreases | choose | handle | hold
     | together | pipeline | stop | skip | trust | elided
     | expr_stmt

let: "let" name "be" expr ["," "or" "else" expr] _NL
var: "var" name "starts" "at" expr _NL
set: "set" place "to" expr _NL
place: name ["of" place]                                                      // FIX-7 a settable place is a name or an of-path
give_back: "give" "back" expr _NL
fail: "fail" "with" name _NL
if_stmt: "if" expr block ("otherwise" "if" expr block)* ["otherwise" block]
for_each: "for" "each" name "from" expr range_word expr block
        | "for" "each" name "in" expr block                        -> for_each_in
repeat_while: "repeat" "while" expr block
invariant: "invariant" expr [because] _NL
decreases: "decreases" expr _NL
choose: "choose" expr _NL _INDENT when+ _DEDENT
when: "when" pattern block | elided
pattern: "some" name                              -> some_pattern
       | "nothing"                                -> nothing_pattern
       | name ["with" name ("and" name)*]         -> variant_pattern
handle: "handle" block on_failure+
on_failure: elided | "on" "failure" name ("or" name)* ["as" name] block
          | "on" "failure" "in" "any" "stage" block                -> on_stage_failure   // SPECIAL EX 39
hold: "hold" name "as" expr block
together: "together" block
pipeline: "pipeline" _NL _INDENT pipe_item+ _DEDENT [on_failure]
?pipe_item: elided
          | "stage" expr ["," INT "at" "a" "time"] _NL                          -> stage
          | "queue" "of" "at" "most" QUANTITY _NL                                -> queue
stop: "stop" ["all" "stages"] _NL                                               // "all stages" SPECIAL EX 39
skip: "skip" _NL
trust: "trust" STRING "owner" name _NL
proof: "proof" _NL _INDENT proof_stmt+ _DEDENT
?proof_stmt: elided
           | "use" "lemma" name _NL                              -> use_lemma
           | "assert" expr _NL                                   -> assert_stmt
elided: ELIDED _NL
expr_stmt: expr _NL

// ---------------------------------------------------------------- expressions
// DOC rule 10: a logic chain is all "and" or all "or"; mixing needs parentheses.
?expr: logic ["implies" logic]                                  -> implication
?logic: negation ("and" negation)+                              -> and_chain
      | negation ("or" negation)+                               -> or_chain
      | negation
?negation: "not" negation                                       -> not_
         | quantified
         | comparison
quantified: "for" "every" name ["in" sum | "from" sum range_word sum | "that" "is" typeexpr] "," expr
          | "there" "is" [article] name "in" sum "where" where_cond -> exists

?comparison: concat
           | concat (comp_op concat)+                           -> compare
           | concat "is" article name "of" concat               -> predicate_of
// FIX-5: bare "in" is no longer a membership alias; "is in" and "∈" remain.
comp_op: "is" | "=" | "=="
       | "is" "not" | "!=" | "≠"
       | "is" "less" "than" | "<"
       | "is" "more" "than" | ">"
       | "is" "at" "most" | "<=" | "≤"
       | "is" "at" "least" | ">=" | "≥"
       | "is" "in" | "∈"
       | "is" "not" "in"
       | "is" "after" | "is" "not" "after" | "is" "before"

?concat: sum ("followed" "by" sum)*
?sum: product (("+" | "-") product)*
?product: unary (("*" | "/" | "mod") unary)*
?unary: "-" unary -> neg
      | postfix
?postfix: application
        | application "at" "entry"                            -> at_entry
        | application "attenuated" "to" cap_spec              -> attenuate   // EX 22

// FIX-3: "of" is an argument label, used at most once and first; its operand
// may itself be an of-path or a call with positional operands. Every other
// label belongs to the outermost call on the line.
// FIX-4: a comprehension may only be the final "of" operand, or in parentheses.
?application: call | operand | construction
          | "try" application                                   -> try_
call: name operand+
    | name operand* "of" of_operand label_arg*
    | name operand* label_arg+
    | name operand* "of" comprehension                         -> aggregate
label_arg: label of_operand
         | "where" where_cond                                   -> where_arg
of_operand: name operand* ["of" of_operand]
          | atom
comprehension: of_operand "for" "each" name "in" of_operand ["where" where_cond]
// D1: "where" takes the rest of its line; D2: a quantifier takes the rest of its line
// (both resolved after parsing, see tools/run3.py; D2 added after the Bison counterexample)
where_cond: expr
label: "from" | "for" | "with" | "in" | "into" | "onto" | "over" | "using"
     | "to" | "by" | "as"
// FIX-6: a construction lists its parts with commas, not "and".
construction: article name "from" operand ("," operand)* ["with" name operand]

?operand: name | atom
?atom: literal
     | "(" expr ")"
     | "(" comprehension ")"                                    -> comprehension_value   // FIX-4
     | "[" [expr ("," expr)*] "]"                               -> list
     | "result"                                                 -> result
     | "nothing"                                                -> nothing
     | "some" operand                                           -> some
?literal: INT | DECIMAL | VERSION | STRING | QUANTITY | DATE

version: VERSION | DECIMAL | INT

// ---------------------------------------------------------------- terminals
_NL: "⏎"
_INDENT: "⇥"
_DEDENT: "⇤"
ELIDED: "⋯"
PROSE: /⟪[^⟫]*⟫/
STRING: /"([^"\\]|\\.)*"/
DATE.3: /\d{4}-\d{2}-\d{2}/
VERSION.2: /\d+\.\d+\.\d+/
DECIMAL.1: /\d+\.\d+/
INT: /\d+/
NAME: /[A-Za-z][A-Za-z0-9_]*/
%ignore /[ \t\n]+/

// ---- generated
name: NAME
    | "about"
    | "added"
    | "all"
    | "any"
    | "anything"
    | "assert"
    | "assumed"
    | "assumes"
    | "authority"
    | "backoff"
    | "but"
    | "can"
    | "cannot"
    | "checking"
    | "compatibility"
    | "components"
    | "consumed"
    | "contains"
    | "database"
    | "domain"
    | "domains"
    | "editable"
    | "else"
    | "entry"
    | "everything"
    | "files"
    | "gives"
    | "host"
    | "its"
    | "labelled"
    | "leaves"
    | "lemma"
    | "limited"
    | "matching"
    | "may"
    | "maybe"
    | "monitor"
    | "must"
    | "needs"
    | "network"
    | "no"
    | "non_empty"
    | "once"
    | "one"
    | "only"
    | "operations"
    | "own"
    | "owner"
    | "per"
    | "port"
    | "positive"
    | "provides"
    | "queue"
    | "reach"
    | "read"
    | "removed"
    | "reserved"
    | "restarts"
    | "retry"
    | "root"
    | "rules"
    | "sampling"
    | "sends"
    | "stage"
    | "stages"
    | "state"
    | "succeeds"
    | "that"
    | "time"
    | "times"
    | "turning"
    | "under"
    | "use"
    | "value"
    | "version"
    | "wiring"
    | "write"
QUANTITY.4: /\d+(\.\d+)?[ ]+(?!(compatibility|declassifies|components|idempotent|everything|operations|attenuated|component|authority|decreases|migration|non_empty|otherwise|invariant|checking|sampling|editable|database|labelled|restarts|positive|deadline|succeeds|followed|survives|contains|anything|pipeline|together|matching|reserved|protocol|property|provides|consumed|workflow|produces|nothing|assumed|failure|limited|turning|through|example|assumes|monitor|because|network|removed|version|changes|domains|implies|backoff|before|handle|choose|repeat|expect|define|wiring|system|ensure|schema|starts|stages|leaves|domain|assert|cannot|result|choice|where|needs|model|while|retry|fails|files|given|about|stage|owner|using|queue|added|entry|trust|least|gives|every|holds|rules|state|field|proof|write|times|reach|until|there|maybe|sends|lemma|value|after|under|each|hold|must|runs|time|fail|less|from|over|uses|tier|else|type|root|into|stop|read|some|give|back|most|host|only|when|than|port|skip|that|with|once|onto|more|any|may|try|the|let|its|all|but|var|and|mod|not|use|for|per|own|can|one|set|an|on|is|in|by|of|as|if|to|be|no|or|at|it|a)(?![A-Za-z0-9_]))[A-Za-z][A-Za-z0-9_]*/

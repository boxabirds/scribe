note Translated from cpython Lib/bisect.py, bisect_right (PSF License Agreement).
note The optional `key` function is left out: Scribe has no function types yet (spec 4.3).
function bisect_right(items: List[Int], x: Int, low: Int, high: Int or nothing) -> Int
    can fail with NegativeLow
    expect is_sorted(items)
    ensure on success, for all i in low until result, items[i] <= x
    ensure on success, for all i in result until count(items), items[i] > x

    if low < 0
        fail with NegativeLow
    var lo = low
    var hi = count(items)
    if high is not nothing
        hi = high
    while lo < hi
        invariant low <= lo
        decreases hi - lo
        let mid = (lo + hi) / 2
        if x < items[mid]
            hi = mid
        else
            lo = mid + 1
    return lo

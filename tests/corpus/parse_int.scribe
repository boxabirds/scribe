note Translated from Go src/internal/strconv/atoi.go, ParseInt (BSD 3-Clause).
note Go returns the clamped value together with ErrRange; in Scribe the failure carries it.
enum ParseIntFailure
    Syntax
    Range(clamped: I64)

function parse_int(text: Text, base: Int, bit_size: Int) -> I64
    can fail with Syntax, Range
    expect bit_size in [0, 8, 16, 32, 64]

    if count(text) == 0
        fail with Syntax
    var digits = text
    var negative = false
    if text[0] == "+"
        digits = drop(text, 1)
    else if text[0] == "-"
        digits = drop(text, 1)
        negative = true

    let unsigned = try parse_uint(digits, base, bit_size) else saturated_uint(digits, base, bit_size)
    var size = bit_size
    if size == 0
        size = int_size
    let cutoff = to_u64(1) << (size - 1)
    if all of not negative, unsigned >= cutoff
        fail with Range(clamped: to_i64(cutoff - 1))
    if negative and unsigned > cutoff
        fail with Range(clamped: -to_i64(cutoff))
    if negative
        return -to_i64(unsigned)
    return to_i64(unsigned)

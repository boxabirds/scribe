to gcd first, second
    given first is a Nat
    given second is a Nat
    produces a Nat
    if second = 0
        return first
    return gcd second, (first mod second)

to move x, y to target
    given x is an Int
    given y is an Int
    given target is an editable Grid
    let g be gcd x, y
    let pairs be [(gcd 12, 18), 6]
    let two be [gcd 12, 18]
    if (gcd x, y) = 1
        move y, x to target

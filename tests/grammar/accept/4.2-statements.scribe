function classify(values: List[Int]) -> Int
    let limit = 100
    var total = 0
    for v in values
        if v < 0
            continue
        else if v > limit
            break
        else
            total = total + v
    var i = 0
    while i < 10
        decreases 10 - i
        i = i + 1
    for j in 0 until count(values)
        total = total + j
    for k in 1 through 6
        do nothing
    return total

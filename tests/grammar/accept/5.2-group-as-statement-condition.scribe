function settle(account: editable Account, amount: Money)
    if all of
        account.is_open
        account.balance >= amount
    then
        account.balance = account.balance - amount
    else if not any of account.is_frozen, account.is_closed
    then
        flag(account)
    else
        do nothing
    while all of
        account.balance < 0
        account.retries > 0
    do
        account.retries = account.retries - 1
